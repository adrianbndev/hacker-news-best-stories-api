{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "RefreshIntervalSeconds": 60,
    "MaxConcurrency": 16,
    "TimeoutSeconds": 10,
    "RetryCount": 3,
    "RetryBaseDelayMilliseconds": 200,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerSeconds": 30
  }
}
